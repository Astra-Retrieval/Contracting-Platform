# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- App ---------------------------------------------------------------------
# Public name shown in the header, emails and Stripe checkout.
NEXT_PUBLIC_APP_NAME="Crew Orchard"
# Where the site runs. Use your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (Project Settings -> API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
# The "anon" key, or the newer "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# The "service_role" key, or the newer "secret" key (sb_secret_...). Server only.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (Developers -> API keys) ----------------------------------------
# Use test-mode keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=""
# Publishable key (pk_test_... / pk_live_...). Safe to expose; shows Stripe's setup form inside the site.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint that points at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""
# Optional. A recurring Price for the pro plan. If empty, checkout creates the
# $29/month price on the fly from the values in src/lib/config.ts.
STRIPE_PRO_PRICE_ID=""

# --- Email notifications (resend.com -> API Keys) ----------------------------
# Leave empty to turn emails off; the app logs what it would have sent instead.
RESEND_API_KEY=""
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="Crew Orchard <notifications@example.com>"
# Where dispute alerts for platform staff are sent.
ADMIN_EMAIL=""
